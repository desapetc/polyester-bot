# Default untuk SEMUA akun. Tiap akun bisa override di accounts.json.

STRATEGY=flip            # flip = buy-sell bolak balik, dca = beli rutin, rsi = sinyal RSI
DRY_RUN=1                # 1 = simulasi, 0 = kirim order beneran (testnet)
INTERVAL_SEC=6           # jeda setelah tiap order sebelum cek saldo & order berikutnya (detik)
QUOTE_PER_TRADE=max      # max = pakai semua saldo USDT, atau isi angka (min 5)
MAX_TRADES=0             # 0 = tanpa batas
MAX_SLIPPAGE_BPS=100     # 100 = 1%
STOP_BELOW_USDT=0        # stop akun kalau total nilainya di bawah ini (0 = off)
START_STAGGER_SEC=0.5    # jeda start antar akun (100 akun = ~50 detik)

# RSI
TIMEFRAME=1m
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
SELL_FRACTION=1
